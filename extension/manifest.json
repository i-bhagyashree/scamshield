{
  "manifest_version": 3,
  "name": "ScamShield: Scam & Phishing Checker",
  "short_name": "ScamShield",
  "version": "1.0.0",
  "description": "Warns you about scam and phishing websites, and checks suspicious messages, links, numbers and UPI IDs.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ScamShield" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
