# Copy to server/.env and fill in.
PORT=5150

# Optional: turns on the Claude AI second opinion. Without it the rule engine still works fully.
ANTHROPIC_API_KEY=

# Comma-separated web origins allowed to call the API (the Chrome extension is always allowed).
CORS_ORIGINS=http://localhost:5180

# SQLite file location.
DB_PATH=scamshield.db

# Demo reports and checks. Default: on in development, off in production (NODE_ENV=production).
# SEED_DEMO=1

# Set to 1 to turn off live domain-age (RDAP) lookups.
DISABLE_NETWORK_CHECKS=0
